# ---- Backend (backend/.env) ----
ENVIRONMENT=development
DATABASE_URL=sqlite:///./slipcast.db
# Use a long random string in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:4200
AUTO_CREATE_TABLES=true

# ---- Web app ----
# Set the API URL in web/public/config.js (or API_URL for the Docker image)

# Optional: Sign in with Google / GitHub. A button appears only when both its values are set.
# Callback URLs to register with each provider: <API URL>/api/auth/google/callback and
# <API URL>/api/auth/github/callback (e.g. http://localhost:8000/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Where the web app lives: sign-in and invite links point here.
PUBLIC_WEB_URL=http://localhost:4200

# Optional: AI advice via Groq. Without a key SlipCast uses rule-based advice everywhere.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
