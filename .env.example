# ---- Backend (backend/.env) ----
ENVIRONMENT=development
DATABASE_URL=sqlite:///./slipcast.db
# Use a long random string in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:4200
AUTO_CREATE_TABLES=true

# ---- Web app ----
# Set the API URL in web/public/config.js (or API_URL for the Docker image)
